# SBSU AI Studio - Sofia - ENV EXAMPLE
# Copy this to .env for local, and add same in Vercel Dashboard

# === CORE - REQUIRED FOR DB & AUTH ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# === AI MODELS - FREE APIs - Add only when needed ===
# Do NOT hardcode keys in HTML, use env only
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_KEY=

# === IMAGE / VIDEO / VOICE FREE APIs ===
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
REMOVE_BG_API_KEY=
PEXELS_API_KEY=
UNSPLASH_API_KEY=
PIXABAY_API_KEY=

# === GOOGLE FREE APIs ===
GOOGLE_MAPS_API_KEY=
GOOGLE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_DRIVE_API_KEY=
GOOGLE_SHEETS_API_KEY=
GMAIL_API_KEY=
FIREBASE_API_KEY=

# === OTHER USEFUL ===
WEATHER_API_KEY=
NEWS_API_KEY=
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
CLOUDINARY_API_KEY=
STRIPE_API_KEY=

# Setup Guide:
# 1. Keep this file as .env.example in repo
# 2. Create .env locally with real keys (don't commit .env)
# 3. In Vercel: Settings > Environment Variables > Add above keys
